FROM node:24.18-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@11.11.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG FIREBASE_API_KEY
ARG FIREBASE_AUTH_DOMAIN
ARG FIREBASE_PROJECT_ID
ARG FIREBASE_APP_ID
ARG FIREBASE_MESSAGING_SENDER_ID
ENV API_BASE_URL=https://localhost:8443 APP_URL=https://localhost:8443 APP_ENV=local APP_NAME="httpSMS Local" NUXT_TELEMETRY_DISABLED=1
ENV APP_GITHUB_URL=https://github.com/316878750/httpsms-home APP_DOCUMENTATION_URL=https://github.com/316878750/httpsms-home/blob/main/deploy/local/README.md APP_DOWNLOAD_URL=https://github.com/316878750/httpsms-home#android
RUN pnpm exec nuxt prepare && pnpm run generate

FROM nginx:1.28-alpine
COPY --from=builder /app/.output/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
