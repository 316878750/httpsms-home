{
    admin off
    auto_https disable_redirects
    default_sni {$HTTPSMS_LAN_IP}
}

# The web UI and the general API are published only on the computer's loopback.
https://localhost:8443 {
    tls internal
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }
    @internal path /v1/events /health
    route {
        respond @internal 403
        handle /v1/* {
            reverse_proxy api:8000
        }
        handle {
            reverse_proxy web:3000
        }
    }
}

# Only authenticated phone upload/registration endpoints exist on the LAN port.
https://{$HTTPSMS_LAN_IP}:8444 {
    tls internal
    # Optional Docker Desktop NAT peer; enable only after host firewall protection.
    @outside not remote_ip {$HTTPSMS_LAN_CIDR} {$HTTPSMS_DOCKER_PEER:127.0.0.1}
    header Cache-Control "no-store"
    request_body {
        max_size 4MB
    }
    @register {
        method PUT
        path /v1/phones/fcm-token
    }
    @receive {
        method POST
        path /v1/messages/receive /v1/heartbeats
    }
    route {
        respond @outside 403
        handle @register {
            reverse_proxy api:8000
        }
        handle @receive {
            reverse_proxy api:8000
        }
        handle {
            respond 403
        }
    }
}
